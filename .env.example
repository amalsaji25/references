# Copy to .env for Docker Compose. Local Java reads exported environment variables.
LLM_PROVIDER=demo
OPENAI_API_KEY=
APP_ACCESS_TOKEN=
SEED_DEMO=true
DATABASE_PASSWORD=local-development-only
# Live mode: LLM_PROVIDER=openai, SEED_DEMO=false, and provide both secrets.
# APP_ACCESS_TOKEN must have at least 24 characters in live mode.
